                  "fields": [
                    {
                      "name": "validation_status",
                      "expression": "`validation_status`"
                    },
                    {
                      "name": "sqft",
                      "expression": "`sqft`"
                    },
                    {
                      "name": "avg(price_predicted)",
                      "expression": "AVG(`price_predicted`)"
                    }
                  ],
                  "disaggregated": false
