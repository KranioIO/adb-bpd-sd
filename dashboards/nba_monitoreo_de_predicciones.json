{
  "datasets": [
    {
      "name": "72eb3e0c",
      "displayName": "Dataset_Predicciones_NBA",
      "queryLines": [
        "SELECT \n",
        "  execution_date,\n",
        "  sqft,\n",
        "  price_predicted,\n",
        "  -- Etiqueta de validación para los colores del gráfico\n",
        "  CASE \n",
        "    WHEN price_predicted < 0 THEN 'Error: Precio Negativo'\n",
        "    WHEN price_predicted > 1000 THEN 'Alerta: Valor Atípico'\n",
        "    ELSE 'OK'\n",
        "  END AS validation_status\n",
        "FROM ${var.catalog_name}.default.ma_table_scores\n",
        "ORDER BY execution_date DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "f6531838",
      "displayName": "Untitled page",
      "layout": [
        {
          "widget": {
            "name": "9a2740d2",
